# ──────────────────────────────────────────────────────────────
# MySchoolGradeFlow — environment variables template
# Copy this file to .env.local for local dev, or set in your
# CI/CD provider / Netlify / Vercel dashboard for production.
# NEVER commit .env or .env.local to git.
# ──────────────────────────────────────────────────────────────

# Supabase project URL — found in Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key — safe to expose in browser bundles
# Dashboard → Project Settings → API → Project API keys → anon/public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ──────────────────────────────────────────────────────────────
# Edge Function secrets — set these via CLI, NEVER in this file:
#   supabase secrets set RESEND_API_KEY=re_...
#   supabase secrets set PAYSTACK_SECRET_KEY=sk_live_...
# ──────────────────────────────────────────────────────────────
